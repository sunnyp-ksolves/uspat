<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout_head" name="Ross Rental Cars · Fonts" inherit_id="website.layout">
        <xpath expr="//head/link[last()]" position="after">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <template id="layout_header" name="Ross Rental Cars · Header" inherit_id="website.layout">
        <xpath expr="//header[@id='top']" position="replace">
            <div class="topbar">
                <div class="wrap">
                    <div class="l"><span class="badge247">24/7</span> Airport pick-up &amp; drop-off anytime — just share your arrival time</div>
                    <div class="r">
                        <a class="ph" href="tel:+5978568668">🇸🇷 (+597) 856-8668</a>
                        <a class="ph" href="tel:+59995136678">🇨🇼 (+5999) 513-6678</a>
                        <span class="lang"><span class="on">EN</span><span>NL</span></span>
                    </div>
                </div>
            </div>
            <header class="hd" id="top" data-anchor="true">
                <div class="wrap">
                    <a class="logo" href="/">
                        <span class="mark">
                            <svg width="23" height="23" viewBox="0 0 24 24" fill="none">
                                <path d="M3 13l2-5a2 2 0 012-1.3h10A2 2 0 0119 8l2 5v5a1 1 0 01-1 1h-1a1 1 0 01-1-1v-1H6v1a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                                <circle cx="7" cy="15" r="1.3" fill="currentColor"/>
                                <circle cx="17" cy="15" r="1.3" fill="currentColor"/>
                            </svg>
                        </span>
                        <span>Ross Rental Cars<small>SURINAME · CURAÇAO</small></span>
                    </a>
                    <nav class="nav">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <a t-att-href="submenu.url" t-att-class="'active' if submenu.url == request.httprequest.path else ''"><t t-esc="submenu.name"/></a>
                        </t>
                    </nav>
                    <div class="spacer"/>
                    <div class="callus"><small>Reserve 24/7</small><b>Book direct &amp; save 10%</b></div>
                    <a class="btn btn-red" href="/fleet">Book Now</a>
                    <button class="menu-toggle" aria-label="Menu" type="button">☰</button>
                </div>
            </header>
        </xpath>
    </template>

    <template id="layout_footer" name="Ross Rental Cars · Footer" inherit_id="website.layout">
        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer class="ft" id="bottom" data-anchor="true">
                <div class="wrap">
                    <div class="ft-grid">
                        <div>
                            <div class="logo" style="color:#fff;margin-bottom:14px">
                                <span class="mark">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                        <path d="M3 13l2-5a2 2 0 012-1.3h10A2 2 0 0119 8l2 5v5a1 1 0 01-1 1h-1a1 1 0 01-1-1v-1H6v1a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                                    </svg>
                                </span> Ross Rental Cars
                            </div>
                            <p>With locations in Suriname and Curaçao, we get you on your way to exploring all that our tropical destinations have to offer.</p>
                            <div class="soc"><a href="#">f</a><a href="#">◎</a><a href="#">in</a></div>
                        </div>
                        <div>
                            <h5>Explore</h5>
                            <p><a href="/">Home</a></p>
                            <p><a href="/fleet">Vehicles</a></p>
                            <p><a href="/#deal">Deals</a></p>
                            <p><a href="/#about">About us</a></p>
                        </div>
                        <div>
                            <h5>Reservations</h5>
                            <p><a href="/fleet">Suriname</a></p>
                            <p><a href="/fleet">Curaçao</a></p>
                            <p><a href="#">My reservations</a></p>
                            <p><a href="/#contact">Contact</a></p>
                        </div>
                        <div>
                            <h5>Office hours</h5>
                            <p><b style="color:#fff">Suriname</b> Mon–Fri 8:00–16:30</p>
                            <p><b style="color:#fff">Curaçao</b> Mon–Fri 8:00–20:00 · Sat–Sun 8:00–18:00</p>
                            <div class="pay"><span>VISA</span><span>Mastercard</span><span>Maestro</span><span>PIN</span></div>
                        </div>
                    </div>
                    <div class="ft-bottom">
                        <span>© 2026 Ross Rental Cars. All rights reserved.</span>
                        <span>Privacy Policy · Terms &amp; Conditions · 🇬🇧 EN / 🇳🇱 NL</span>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

</odoo>
